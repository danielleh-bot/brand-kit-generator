<!-- Feed Card Component — every visual is driven by a brand-kit token so the
     card matches the publisher's real article cards (aspect ratio, card-title
     type, meta type, button shape, kicker), not generic defaults. -->
<div class="feed-card" style="border-radius: {{default @root.brandKit.photo_style.thumbnail_format.border_radius '0px'}}; overflow: hidden; cursor: pointer;">
  <div class="feed-card-image-wrap" style="position: relative; aspect-ratio: {{aspectRatio @root.brandKit.photo_style.thumbnail_format.aspect_ratio '16 / 9'}};">
    <img src="{{thumbnail}}" alt="{{headline}}" loading="lazy" referrerpolicy="no-referrer"
         {{#if thumbnailFallback}}data-fallback="{{thumbnailFallback}}"{{/if}}
         style="width: 100%; height: 100%; object-fit: cover; display: block;"
         onerror="var fb=this.getAttribute('data-fallback');if(fb&&this.src!==fb){this.removeAttribute('data-fallback');this.src=fb;return;}this.onerror=null;this.style.display='none';this.parentElement.classList.add('feed-card-image-fallback');" />
    {{#unless isNative}}
      <span class="badge-sponsored" style="position: absolute; top: 8px; left: 8px;">Sponsored</span>
    {{/unless}}
  </div>
  <div style="padding: {{#if (eq size 'tiny')}}10px 2px 6px{{else}}{{default @root.brandKit.layout_patterns.content_cards.padding '12px 2px 8px'}}{{/if}};">
    {{#if isNative}}{{#if category}}<div class="feed-card-kicker">{{category}}</div>{{/if}}{{/if}}
    <div class="feed-card-headline {{#if (eq size 'large')}}is-large{{else if (eq size 'tiny')}}is-tiny{{/if}}">
      {{headline}}
    </div>
    <div class="feed-card-foot" style="display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: 10px;">
      <span class="feed-card-source">{{source}}</span>
      {{#if cta}}
        {{#if isNative}}
          <span class="feed-card-cta-link">{{cta}}</span>
        {{else}}
          <span class="feed-card-cta-pill">{{cta}}</span>
        {{/if}}
      {{/if}}
    </div>
  </div>
</div>
