<!-- Feed Card Component -->
<div class="feed-card" style="border-radius: {{default ../../brandKit.photo_style.thumbnail_format.border_radius '6px'}}; overflow: hidden; cursor: pointer;">
  <div class="feed-card-image-wrap" style="position: relative; aspect-ratio: 4/3;">
    <img src="{{thumbnail}}" alt="{{headline}}" loading="lazy" referrerpolicy="no-referrer"
         style="width: 100%; height: 100%; object-fit: cover; display: block; border-radius: {{default ../../brandKit.photo_style.thumbnail_format.border_radius '6px'}} {{default ../../brandKit.photo_style.thumbnail_format.border_radius '6px'}} 0 0;"
         onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('feed-card-image-fallback');" />
    {{#unless isNative}}
      <span class="badge-sponsored" style="position: absolute; top: 8px; left: 8px;">Sponsored</span>
    {{/unless}}
    {{#if isNative}}
      {{#if category}}
        <span style="position: absolute; top: 8px; left: 8px; font-size: 10px; padding: 2px 6px; border-radius: 3px; background: var(--brand-primary); color: #fff; text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600;">{{category}}</span>
      {{/if}}
    {{/if}}
  </div>
  <div style="padding: {{#if (eq size 'tiny')}}10px 6px 6px{{else}}14px 6px 8px{{/if}};">
    <div class="feed-card-headline" style="font-size: {{#if (eq size 'large')}}16px{{else if (eq size 'tiny')}}13px{{else}}14px{{/if}}; margin-bottom: 10px;">
      {{headline}}
    </div>
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
      <span class="feed-card-source">{{source}}</span>
      {{#if cta}}
        {{#if isNative}}
          <span class="feed-card-cta-link">{{cta}}</span>
        {{else}}
          <span class="feed-card-cta-pill">{{cta}}</span>
        {{/if}}
      {{/if}}
    </div>
  </div>
</div>
