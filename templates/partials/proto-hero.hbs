<!-- Hero Image Section
     `content.heroImage` is a plain URL string from extractContent's
     og:image meta lookup. Publishers often host these on a CDN that's
     referrer-locked (images.wcdn.co.il for walla, etc.) — referrerpolicy
     and the onerror fallback keep the page from showing a broken icon
     when that happens. -->
{{#if content.heroImage}}
<div style="max-width: 1200px; margin: 0 auto; padding: 24px 16px 0;">
  <div class="proto-hero-img" style="position: relative; overflow: hidden; border-radius: {{default brandKit.photo_style.thumbnail_format.border_radius '4px'}}; aspect-ratio: 16/9; background: var(--brand-bg-section);">
    <img src="{{content.heroImage}}" alt="{{default content.headline 'Article hero image'}}"
         loading="eager" referrerpolicy="no-referrer"
         style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;"
         onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('feed-card-image-fallback');" />
  </div>
  {{#if content.heroCaption}}
    <p style="font-size: var(--size-meta, 13px); color: var(--brand-text-tertiary); margin: 8px 0 0;">{{content.heroCaption}}</p>
  {{/if}}
</div>
{{/if}}
