<!-- Before / After Visual Comparison — embeds the rendered "default-feed.html"
     (generic Taboola styling applied to the same article) and "index.html"
     (the publisher-branded prototype) as live iframes. They sit inside a
     scaled wrapper so they fit side-by-side at a glance; click "Open" to
     inspect either at full size. -->
<div style="margin-bottom: 32px;">
  <div class="section-title"><h2>Visual Comparison — same article, before &amp; after</h2></div>
  <div class="grid-2" style="gap: 24px;">

    <!-- Before -->
    <div class="card" style="border-top: 3px solid #666; padding: 0; overflow: hidden;">
      <div style="padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border);">
        <h3 style="font-size: 13px; color: var(--text-muted); margin: 0; text-transform: uppercase; letter-spacing: 0.05em;">Before — Generic Taboola</h3>
        <a href="./default-feed.html" target="_blank" rel="noopener" style="font-size: 11px; color: var(--text-muted); text-decoration: none; padding: 4px 10px; border: 1px solid var(--border); border-radius: 4px;">Open ↗</a>
      </div>
      <div style="position: relative; height: 540px; overflow: hidden; background: #fff;">
        <iframe src="./default-feed.html" loading="lazy" title="Before — generic Taboola feed"
          style="position: absolute; top: 0; left: 0; width: 200%; height: 200%; border: none; transform: scale(0.5); transform-origin: top left; background: #fff;"></iframe>
      </div>
    </div>

    <!-- After -->
    <div class="card" style="border-top: 3px solid var(--accent); padding: 0; overflow: hidden;">
      <div style="padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border);">
        <h3 style="font-size: 13px; color: var(--accent); margin: 0; text-transform: uppercase; letter-spacing: 0.05em;">After — {{brandKit.brand.name}} Branded</h3>
        <a href="./index.html" target="_blank" rel="noopener" style="font-size: 11px; color: var(--text-muted); text-decoration: none; padding: 4px 10px; border: 1px solid var(--border); border-radius: 4px;">Open ↗</a>
      </div>
      <div style="position: relative; height: 540px; overflow: hidden; background: #fff;">
        <iframe src="./index.html" loading="lazy" title="After — publisher-branded feed"
          style="position: absolute; top: 0; left: 0; width: 200%; height: 200%; border: none; transform: scale(0.5); transform-origin: top left; background: #fff;"></iframe>
      </div>
    </div>

  </div>
  <p style="font-size: 12px; color: var(--text-muted); margin-top: 12px;">
    Both previews show the same article URL with the same content. The only difference is the brand kit: colours, fonts, spacing, and layout applied on the right.
  </p>
</div>
