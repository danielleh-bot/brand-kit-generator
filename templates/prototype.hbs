<!DOCTYPE html>
<html lang="{{default brandKit.brand.language 'en'}}" dir="{{textDirection brandKit.brand.language}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{brandKit.brand.name}} — Feed Prototype</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="{{googleFontsUrl}}" rel="stylesheet">
  <style>
    :root {
      --brand-primary: {{default brandKit.colors.primary.hex '#1a73e8'}};
      --brand-secondary: {{default brandKit.colors.secondary.hex (default brandKit.colors.primary.hex '#1a73e8')}};
      --brand-text: {{default brandKit.colors.text.primary.hex '#1a1a1a'}};
      --brand-text-secondary: {{default brandKit.colors.text.secondary.hex '#555555'}};
      --brand-text-tertiary: {{default brandKit.colors.text.tertiary.hex '#888888'}};
      --brand-bg: {{default brandKit.colors.backgrounds.base.hex '#ffffff'}};
      --brand-bg-section: {{default brandKit.colors.backgrounds.section.hex '#f5f5f5'}};
      --brand-bg-dark: {{default brandKit.colors.backgrounds.dark.hex '#1a1a1a'}};
      --brand-accent-warning:  {{default brandKit.colors.accents.warning_yellow.hex '#f59e0b'}};
      --brand-accent-negative: {{default brandKit.colors.accents.negative_red.hex '#dc2626'}};
      --brand-accent-positive: {{default brandKit.colors.accents.positive_green.hex '#10b981'}};
      --font-headline: '{{resolveFont brandKit.fonts.primary.family}}', sans-serif;
      --font-body: '{{resolveFont brandKit.fonts.secondary.family}}', sans-serif;

      /* Real publisher type scale, clamped to sane bounds so a glitchy
         extracted value (e.g. 960px from a viewport-relative unit) can't
         break the layout. */
      --size-hero:    {{clampSize brandKit.fonts.type_scale.article_title_hero.size  '24px' '64px' '36px'}};
      --size-card:    {{clampSize brandKit.fonts.type_scale.article_title_card.size  '14px' '24px' '18px'}};
      --size-body:    {{clampSize brandKit.fonts.type_scale.article_body.size        '14px' '22px' '18px'}};
      --size-meta:    {{clampSize brandKit.fonts.type_scale.meta_text.size           '10px' '16px' '13px'}};
      --weight-hero:  {{default brandKit.fonts.type_scale.article_title_hero.weight 700}};
      --leading-body: {{default brandKit.fonts.type_scale.article_body.line_height '1.65'}};

      /* Real button tokens, captured from a prominent CTA on the page.
         These drive the feed-card pill so a pill-button site looks like
         pill buttons and a square-button site looks square. */
      --btn-radius: {{default brandKit.buttons.primary.border_radius '6px'}};
      --btn-padding: {{default brandKit.buttons.primary.padding '8px 16px'}};
      --btn-weight: {{default brandKit.buttons.primary.font_weight 700}};
      --btn-transform: {{default brandKit.buttons.primary.text_transform 'none'}};
      --btn-tracking: {{default brandKit.buttons.primary.letter_spacing '0.04em'}};
      --btn-primary-hover: {{default brandKit.colors.primary_variants.darken_5.hex (default brandKit.colors.primary.hex '#1a73e8')}};
    }
    * { box-sizing: border-box; }
    body {
      font-family: var(--font-body);
      color: var(--brand-text);
      background: var(--brand-bg);
      margin: 0;
      line-height: 1.5;
    }
    html[dir="rtl"] body { direction: rtl; text-align: right; }
    .brand-accent { color: var(--brand-primary); }
    .brand-accent-bg { background: var(--brand-primary); }
    .headline-font { font-family: var(--font-headline); }
    .body-font { font-family: var(--font-body); }
    a { color: var(--brand-primary); text-decoration: none; }
    a:hover { text-decoration: underline; }
    img { max-width: 100%; }

    /* Feed card styles */
    .feed-card {
      transition: box-shadow 0.2s, transform 0.2s;
      background: var(--brand-bg);
      border: 1px solid var(--brand-bg-section);
    }
    .feed-card:hover {
      box-shadow: 0 6px 24px rgba(0,0,0,0.08);
      transform: translateY(-2px);
    }
    .feed-card-headline {
      font-family: var(--font-headline);
      font-weight: 700;
      color: var(--brand-text);
      line-height: 1.3;
    }
    .feed-card-headline:hover { color: var(--brand-primary); }
    .feed-card-source {
      font-size: 11px;
      color: var(--brand-text-tertiary);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-weight: 600;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    /* Native cards: subtle text link — preserves the editorial feel. */
    .feed-card-cta-link {
      font-size: 12px;
      color: var(--brand-primary);
      font-weight: 700;
      white-space: nowrap;
    }
    /* Sponsored cards: outline button that fills on hover. Shape comes
       from the publisher's real button — border-radius, padding,
       text-transform, weight all extracted at crawl time. */
    .feed-card-cta-pill {
      display: inline-flex;
      align-items: center;
      padding: 6px 14px;
      background: transparent;
      color: var(--brand-primary);
      border: 1px solid var(--brand-primary);
      border-radius: var(--btn-radius);
      font-size: 11px;
      font-weight: var(--btn-weight);
      letter-spacing: var(--btn-tracking);
      text-transform: var(--btn-transform);
      white-space: nowrap;
      transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
    }
    .feed-card:hover .feed-card-cta-pill {
      background: var(--brand-primary);
      color: var(--brand-bg);
      transform: translateY(-1px);
    }

    /* Image wrap background lives in a class so the fallback class can
       override it cleanly. Inline styles would have higher specificity
       and silently break the fallback. */
    .feed-card-image-wrap {
      background: var(--brand-bg-section);
      overflow: hidden;
    }
    /* Gradient fallback when an Unsplash thumbnail 404s — the img tag's
       onerror hides itself and adds .feed-card-image-fallback to its
       parent. Two-class selector wins specificity over .feed-card-image-wrap. */
    .feed-card-image-wrap.feed-card-image-fallback {
      background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-bg-dark) 100%);
    }
    .feed-card-image-wrap.feed-card-image-fallback::after {
      content: '';
      position: absolute; inset: 0;
      background-image: repeating-linear-gradient(
        45deg,
        rgba(255,255,255,0.08) 0px,
        rgba(255,255,255,0.08) 8px,
        transparent 8px,
        transparent 16px
      );
    }
    .feed-card-image-wrap.feed-card-image-fallback::before {
      content: '';
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 40px; height: 40px;
      border-radius: 999px;
      background: rgba(255,255,255,0.18);
      backdrop-filter: blur(4px);
    }
    .section-label {
      font-family: var(--font-headline);
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--brand-text-secondary);
      padding-bottom: 8px;
      margin-bottom: 16px;
      border-bottom: 3px solid var(--brand-primary);
    }
    .badge-sponsored {
      font-size: 10px;
      padding: 3px 7px;
      border-radius: 3px;
      background: rgba(0,0,0,0.65);
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 700;
    }

    /* CTA button — replaces the previous inline-link styling that the
       brand owner flagged as "looks weird". Now reads as a real action. */
    .brand-cta-button {
      display: inline-block;
      padding: 10px 18px;
      background: var(--brand-primary);
      color: var(--brand-bg);
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: 14px;
      border-radius: 4px;
      text-decoration: none;
      transition: filter 160ms ease, transform 160ms ease;
    }
    .brand-cta-button:hover { filter: brightness(0.92); transform: translateY(-1px); text-decoration: none; }
  </style>
</head>
<body>
  {{> proto-nav}}
  {{> proto-hero}}
  {{> proto-article}}
  {{> proto-feed}}
  {{> proto-footer}}
</body>
</html>
