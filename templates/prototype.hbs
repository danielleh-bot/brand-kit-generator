<!DOCTYPE html>
<html lang="{{default brandKit.brand.language 'en'}}" dir="{{textDirection brandKit.brand.language}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{brandKit.brand.name}} — Feed Prototype</title>
  {{#if brandKit.logos.favicon_url}}
  <link rel="icon" href="{{brandKit.logos.favicon_url}}" referrerpolicy="no-referrer">
  {{/if}}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="{{googleFontsUrl}}" rel="stylesheet">
  <style>
    :root {
      --brand-primary: {{default brandKit.colors.primary.hex '#1a73e8'}};
      --brand-secondary: {{default brandKit.colors.secondary.hex (default brandKit.colors.primary.hex '#1a73e8')}};
      --brand-text: {{default brandKit.colors.text.primary.hex '#1a1a1a'}};
      --brand-text-secondary: {{default brandKit.colors.text.secondary.hex '#555555'}};
      --brand-text-tertiary: {{default brandKit.colors.text.tertiary.hex '#888888'}};
      --brand-bg: {{default brandKit.colors.backgrounds.base.hex '#ffffff'}};
      --brand-bg-section: {{default brandKit.colors.backgrounds.section.hex '#f5f5f5'}};
      --brand-bg-dark: {{default brandKit.colors.backgrounds.dark.hex '#1a1a1a'}};
      --brand-accent-warning:  {{default brandKit.colors.accents.warning_yellow.hex '#f59e0b'}};
      --brand-accent-negative: {{default brandKit.colors.accents.negative_red.hex '#dc2626'}};
      --brand-accent-positive: {{default brandKit.colors.accents.positive_green.hex '#10b981'}};
      --font-headline: '{{resolveFont brandKit.fonts.primary.family}}', sans-serif;
      --font-body: '{{resolveFont brandKit.fonts.secondary.family}}', sans-serif;

      /* Real publisher type scale, clamped to sane bounds so a glitchy
         extracted value (e.g. 960px from a viewport-relative unit) can't
         break the layout. */
      --size-hero:    {{clampSize brandKit.fonts.type_scale.article_title_hero.size  '24px' '64px' '36px'}};
      --size-card:    {{clampSize brandKit.fonts.type_scale.article_title_card.size  '14px' '24px' '18px'}};
      --size-body:    {{clampSize brandKit.fonts.type_scale.article_body.size        '14px' '22px' '18px'}};
      --size-meta:    {{clampSize brandKit.fonts.type_scale.meta_text.size           '10px' '16px' '13px'}};
      --weight-hero:  {{default brandKit.fonts.type_scale.article_title_hero.weight 700}};
      --leading-body: {{default brandKit.fonts.type_scale.article_body.line_height '1.65'}};

      /* Real button tokens, captured from a prominent CTA on the page.
         These drive the feed-card pill so a pill-button site looks like
         pill buttons and a square-button site looks square. */
      --btn-radius: {{default brandKit.buttons.primary.border_radius '6px'}};
      --btn-padding: {{default brandKit.buttons.primary.padding '8px 16px'}};
      --btn-weight: {{default brandKit.buttons.primary.font_weight 700}};
      --btn-transform: {{default brandKit.buttons.primary.text_transform 'none'}};
      --btn-tracking: {{default brandKit.buttons.primary.letter_spacing '0.04em'}};
      --btn-primary-hover: {{default brandKit.colors.primary_variants.darken_5.hex (default brandKit.colors.primary.hex '#1a73e8')}};

      /* Content-card tokens from the brand kit */
      --card-border: {{default brandKit.layout_patterns.content_cards.border '1px solid transparent'}};
      --card-padding: {{default brandKit.layout_patterns.content_cards.padding '12px'}};
      --card-gap: {{default brandKit.spacing.card_gap '16px'}};
    }
    * { box-sizing: border-box; }
    body {
      font-family: var(--font-body);
      color: var(--brand-text);
      background: var(--brand-bg);
      margin: 0;
      line-height: 1.5;
    }
    html[dir="rtl"] body { direction: rtl; text-align: right; }
    .brand-accent { color: var(--brand-primary); }
    .brand-accent-bg { background: var(--brand-primary); }
    .headline-font { font-family: var(--font-headline); }
    .body-font { font-family: var(--font-body); }
    a { color: var(--brand-primary); text-decoration: none; }
    a:hover { text-decoration: underline; }
    nav a:hover, .feed-card a:hover { text-decoration: none; }
    img { max-width: 100%; }

    /* Feed card styles — type & behaviour driven by the extracted tokens so
       cards read as native publisher cards. BI (and most editorial sites)
       don't lift cards on hover; the real behaviour is "headline picks up the
       accent" (layout_patterns.content_cards.hover), so that's what we do. */
    .feed-card {
      background: var(--brand-bg);
      border: var(--card-border);
    }
    /* Kicker / category — a coloured text eyebrow above the headline (BI uses
       a coloured kicker, not a filled badge over the image). */
    .feed-card-kicker {
      font-family: var(--font-headline);
      color: var(--brand-primary);
      font-weight: 700;
      font-size: 11px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    /* Card headline — weight / leading / colour from the publisher's real
       card-title token (type_scale.article_title_card). */
    .feed-card-headline {
      font-family: var(--font-headline);
      font-weight: {{default brandKit.fonts.type_scale.article_title_card.weight 700}};
      color: {{default brandKit.fonts.type_scale.article_title_card.color 'var(--brand-text)'}};
      line-height: {{default brandKit.fonts.type_scale.article_title_card.line_height '1.25'}};
      font-size: 15px;
      transition: color 0.15s ease;
    }
    .feed-card-headline.is-large { font-size: {{clampSize brandKit.fonts.type_scale.article_title_card.size '16px' '22px' '20px'}}; }
    .feed-card-headline.is-tiny { font-size: 13px; }
    .feed-card:hover .feed-card-headline { color: var(--brand-primary); }
    /* Source / attribution — from the publisher's real meta-text token. */
    .feed-card-source {
      font-size: var(--size-meta);
      color: var(--brand-text-tertiary);
      font-weight: 400;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    /* Native cards: subtle text link — preserves the editorial feel. */
    .feed-card-cta-link {
      font-size: 12px;
      color: var(--brand-primary);
      font-weight: 700;
      white-space: nowrap;
    }
    /* Sponsored cards: a SOLID button matching the publisher's real CTA
       (buttons.primary) — background, text colour, radius, weight, tracking
       and casing all extracted at crawl time. This is the biggest "native"
       win: the paid CTA now looks like the site's own button. */
    .feed-card-cta-pill {
      display: inline-flex;
      align-items: center;
      padding: 6px 14px;
      background: {{default brandKit.buttons.primary.background_color 'var(--brand-primary)'}};
      color: {{default brandKit.buttons.primary.text_color 'var(--brand-bg)'}};
      border: 1px solid {{default brandKit.buttons.primary.background_color 'var(--brand-primary)'}};
      border-radius: var(--btn-radius);
      font-size: 12px;
      font-weight: var(--btn-weight);
      letter-spacing: var(--btn-tracking);
      text-transform: var(--btn-transform);
      white-space: nowrap;
      transition: background 160ms ease;
    }
    .feed-card:hover .feed-card-cta-pill { background: var(--btn-primary-hover); }

    /* Image wrap background lives in a class so the fallback class can
       override it cleanly. Inline styles would have higher specificity
       and silently break the fallback. The wrapper relies on the inline
       `aspect-ratio: 4/3` on the partial — no min-height, since on narrow
       3-column rows that floor would override the aspect ratio and stretch
       images vertically. */
    .feed-card-image-wrap {
      background: var(--brand-bg-section);
      overflow: hidden;
    }
    /* Gradient fallback when an Unsplash thumbnail 404s — the img tag's
       onerror hides itself and adds .feed-card-image-fallback to its
       parent. Two-class selector wins specificity over .feed-card-image-wrap. */
    .feed-card-image-wrap.feed-card-image-fallback {
      background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-bg-dark) 100%);
    }
    .feed-card-image-wrap.feed-card-image-fallback::after {
      content: '';
      position: absolute; inset: 0;
      background-image: repeating-linear-gradient(
        45deg,
        rgba(255,255,255,0.08) 0px,
        rgba(255,255,255,0.08) 8px,
        transparent 8px,
        transparent 16px
      );
    }
    .feed-card-image-wrap.feed-card-image-fallback::before {
      content: '';
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 40px; height: 40px;
      border-radius: 999px;
      background: rgba(255,255,255,0.18);
      backdrop-filter: blur(4px);
    }
    .section-label {
      font-family: var(--font-headline);
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--brand-text-secondary);
      padding-bottom: 8px;
      margin-bottom: 16px;
      border-bottom: 3px solid var(--brand-primary);
    }
    .badge-sponsored {
      font-size: 10px;
      padding: 3px 7px;
      border-radius: 3px;
      background: rgba(0,0,0,0.65);
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 700;
    }

    /* CTA button — replaces the previous inline-link styling that the
       brand owner flagged as "looks weird". Now reads as a real action. */
    .brand-cta-button {
      display: inline-block;
      padding: 10px 20px;
      background: var(--brand-primary);
      color: var(--brand-bg);
      font-family: var(--font-headline);
      font-weight: var(--btn-weight);
      font-size: 14px;
      border-radius: var(--btn-radius);
      letter-spacing: var(--btn-tracking);
      text-transform: var(--btn-transform);
      text-decoration: none;
      transition: background 160ms ease;
    }
    .brand-cta-button:hover { background: var(--btn-primary-hover); text-decoration: none; }

    /* Logo sizing — the inline SVG comes from a publisher page where it
       might declare its own width/height attributes (often >38px). Force it
       to fit the nav slot by overriding both attributes via CSS. Same goes
       for the wrapper span: keep the SVG vertically centered, never let it
       overflow vertically. */
    .nav-logo-svg {
      display: inline-flex;
      align-items: center;
      height: 38px;
      max-width: 240px;
      overflow: hidden;
    }
    .nav-logo-svg > svg {
      height: 100% !important;
      width: auto !important;
      max-width: 100% !important;
      display: block;
    }

    /* Responsive collapse: 3-up and 4-up grids don't fit on phones. The
       inline grid-template-columns on the partials sits at higher
       specificity, so we override with !important inside the breakpoint. */
    @media (max-width: 720px) {
      [data-feed-grid="3-up"],
      [data-feed-grid="2-up"] { grid-template-columns: 1fr 1fr !important; gap: var(--card-gap) !important; }
      [data-footer-grid] { grid-template-columns: 1fr 1fr !important; gap: 20px !important; }
    }
    @media (max-width: 480px) {
      [data-feed-grid] { grid-template-columns: 1fr !important; }
      [data-footer-grid] { grid-template-columns: 1fr !important; }
    }
  </style>
</head>
<body>
  {{> proto-nav}}
  {{> proto-hero}}
  {{> proto-article}}
  {{> proto-feed}}
  {{> proto-footer}}
</body>
</html>
